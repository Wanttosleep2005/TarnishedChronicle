{
  "name": "tarnished-chronicle",
  "version": "0.3.1",
  "description": "存档编年史 — 艾尔登法环 / 杀戮尖塔 2 / 黑暗之魂 3 存档分析:进度、图鉴、成就与 LLM 游玩故事",
  "author": "Tarnished Chronicle Contributors",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "smoke": "tsx scripts/parse-smoke.ts",
    "audit:data": "tsx scripts/audit-er-data.ts",
    "package": "electron-vite build && electron-builder --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "effect": "4.0.0-beta.75",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "koffi": "^3.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
